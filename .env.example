# Documentation only. scripts/dev.sh prepare creates private .dev/*.env files.
# Never use example values as credentials or source a downloaded env file.
CP_UID=1000
CP_GID=1000
TAILNET_IP=100.64.0.1
CHECKPOINT_PUBLIC_URL=https://node.example.ts.net
CHECKPOINT_SIGNAL_URL=wss://node.example.ts.net:9443
CHECKPOINT_OBSERVER_URL=https://node.example.ts.net:9444
LIVEKIT_API_KEY=generated-by-prepare
LIVEKIT_API_SECRET=generated-by-prepare
CHECKPOINT_MEETING_INVITE=generated-by-prepare
CHECKPOINT_HOST_INVITE=generated-by-prepare
CHECKPOINT_VIEWER_INVITE=generated-by-prepare
