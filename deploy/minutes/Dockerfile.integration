FROM golang:1.27.3-bookworm AS go
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg espeak-ng ca-certificates cmake make g++ git libcurl4-openssl-dev && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:$PATH
RUN pip install --no-cache-dir pip-tools==7.5.2
WORKDIR /work
