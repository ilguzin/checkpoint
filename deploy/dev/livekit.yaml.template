# The container has its own network namespace. Only the loopback API mapping
# and Tailscale-IP media mappings are published by Compose.
port: 7880
bind_addresses: ["0.0.0.0"]
rtc:
  node_ip: "${TAILNET_IP}"
  use_external_ip: false
  tcp_port: 7881
  udp_port: 7882
  port_range_start: 0
  port_range_end: 0
  interfaces:
    includes: ["eth0"]
  enable_loopback_candidate: false
  use_ice_lite: true
keys:
  ${LIVEKIT_API_KEY}: "${LIVEKIT_API_SECRET}"
webhook:
  api_key: "${LIVEKIT_API_KEY}"
  urls: ["http://core:8080/api/livekit/webhook"]
room:
  max_participants: 200
  empty_timeout: 300
logging:
  level: warn
